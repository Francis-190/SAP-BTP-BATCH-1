<mvc:View
    controllerName="procurement.controller.PODetail"
    height="100%"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap">

    <Page id="poPage" title="Purchase Order" showNavButton="true"
          navButtonPress=".onNavBack" enableScrolling="false" class="entPage">
        <content>
            <uxap:ObjectPageLayout id="poLayout" upperCaseAnchorBar="false"
                                   showTitleInHeaderContent="false">

                <!-- ===== title ===== -->
                <uxap:headerTitle>
                    <uxap:ObjectPageDynamicHeaderTitle id="_IDGenObjectPageDynamicHeaderTitle">
                        <uxap:expandedHeading>
                            <Title id="_IDGenTitle" text="{po>/po/poNumber}" wrapping="true"/>
                        </uxap:expandedHeading>
                        <uxap:snappedHeading>
                            <Title id="_IDGenTitle1" text="{po>/po/poNumber}"/>
                        </uxap:snappedHeading>
                        <uxap:expandedContent>
                            <Text id="_IDGenText" text="Supplier: {po>/po/supplierName}"/>
                        </uxap:expandedContent>
                        <uxap:actions>
                            <Button id="_IDGenButton" text="Send to Supplier" type="Emphasized"
                                    icon="sap-icon://shipping-status"
                                    enabled="{po>/canSend}" press=".onSendToSupplier"/>
                            <Button id="_IDGenButton1" icon="sap-icon://refresh" tooltip="Refresh" press=".onRefresh"/>
                        </uxap:actions>
                    </uxap:ObjectPageDynamicHeaderTitle>
                </uxap:headerTitle>

                <!-- ===== header facts ===== -->
                <uxap:headerContent>
                    <HBox id="_IDGenHBox" wrap="Wrap" alignItems="Start">
                        <VBox id="_IDGenVBox" class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                            <Label id="_IDGenLabel" text="Status"/>
                            <ObjectStatus id="_IDGenObjectStatus" text="{po>/po/status}" inverted="true"
                                          state="{path:'po>/po/status', formatter:'.formatPOState'}"/>
                        </VBox>
                        <VBox id="_IDGenVBox1" class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                            <Label id="_IDGenLabel1" text="Supplier"/>
                            <Text id="_IDGenText1" text="{po>/po/supplierName}"/>
                        </VBox>
                        <VBox id="_IDGenVBox2" class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                            <Label id="_IDGenLabel2" text="Purchase Requisition"/>
                            <Text id="_IDGenText2" text="{po>/po/prNumber}"/>
                        </VBox>
                        <VBox id="_IDGenVBox3" class="sapUiMediumMarginEnd sapUiTinyMarginBottom">
                            <Label id="_IDGenLabel3" text="Created"/>
                            <Text id="_IDGenText3" text="{po>/po/createdAtText}"/>
                        </VBox>
                      
                        <VBox id="_IDGenVBox4" class="sapUiTinyMarginBottom">
                            <Label id="_IDGenLabel4" text="Received"/>
                            <ProgressIndicator id="_IDGenProgressIndicator" percentValue="{po>/summary/progress}"
                                               displayValue="{po>/summary/received} / {po>/summary/ordered}"
                                               state="{po>/summary/state}" width="12rem"/>
                        </VBox>
                    </HBox>
                </uxap:headerContent>

                <!-- ===== sections ===== -->
                <uxap:sections>
                    <uxap:ObjectPageSection id="_IDGenObjectPageSection" title="Items" titleUppercase="false">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection">
                                <Table id="_IDGenTable" items="{po>/items}" noDataText="This PO has no items">
                                    <columns>
                                        <Column id="_IDGenColumn1"><Text id="_IDGenText4" text="Part"/></Column>
                                        <Column id="_IDGenColumn2" hAlign="End"><Text id="_IDGenText5" text="Ordered"/></Column>
                                        <Column id="_IDGenColumn3" hAlign="End"><Text id="_IDGenText6" text="Received"/></Column>
                    
                                    </columns>
                                    <items>
                                        <ColumnListItem id="_IDGenColumnListItem">
                                            <cells>
                                                <ObjectIdentifier id="_IDGenObjectIdentifier" title="{po>partNumber}" text="{po>description}"/>
                                                <ObjectNumber id="_IDGenObjectNumber" number="{po>orderedQty}"/>
                                                <ObjectNumber id="_IDGenObjectNumber1" number="{po>receivedQty}" state="Success"/>
                                                <ObjectNumber id="_IDGenObjectNumber2" number="{po>remainingQty}"
                                                              state="{= ${po>remainingQty} > 0 ? 'Warning' : 'None'}"/>
                                                <ObjectNumber id="_IDGenObjectNumber3" number="{po>unitPrice}"/>
                                                <ObjectNumber id="_IDGenObjectNumber4" number="{po>lineTotal}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection id="_IDGenObjectPageSection1" title="Goods Receipts" titleUppercase="false">
                        <uxap:subSections>
                            <uxap:ObjectPageSubSection id="_IDGenObjectPageSubSection1">
                                <Table id="_IDGenTable1" items="{po>/grs}" noDataText="No goods receipts posted yet">
                                    <columns>
                                        <Column id="_IDGenColumn4"><Text id="_IDGenText7" text="GR Number"/></Column>
                                        <Column id="_IDGenColumn5"><Text id="_IDGenText8" text="Location"/></Column>
                                        <Column id="_IDGenColumn6"><Text id="_IDGenText9" text="Received By"/></Column>
                                        <Column id="_IDGenColumn7"><Text id="_IDGenText10" text="Posted On"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem id="_IDGenColumnListItem1">
                                            <cells>
                                                <ObjectIdentifier id="_IDGenObjectIdentifier1" title="{po>grNumber}"/>
                                                <Text id="_IDGenText11" text="{po>locationText}"/>
                                                <Text id="_IDGenText12" text="{po>receivedBy}"/>
                                                <Text id="_IDGenText13" text="{po>createdAtText}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </uxap:ObjectPageSubSection>
                        </uxap:subSections>
                    </uxap:ObjectPageSection>
                </uxap:sections>
            </uxap:ObjectPageLayout>
        </content>
    </Page>
</mvc:View>