@url = http://localhost:4004
@servicepath = /odata/v4/procurement
@base = {{url}}{{servicepath}}

### ---------- READ DATA ----------
GET {{base}}/PurchaseRequisitions

###
GET {{base}}/PurchaseRequisitionItems

###
GET {{base}}/PurchaseOrders

###
GET {{base}}/PurchaseOrderItems

###
GET {{base}}/GoodsReceipts

###
GET {{base}}/GoodsReceiptItems

###
GET {{base}}/Suppliers

###
GET {{base}}/AlertNotifications

### ---------- CREATE THE PR ----------
# @name createPR
POST {{base}}/PurchaseRequisitions
Content-Type: application/json

{
  "prNumber": "PR-TEST-004",
  "location_ID": "eb366403-27af-4380-9d74-800a53ab8081",
  "requestedBy": "vamsi",
  "items": [
    {
      "part_ID": "bd2c74bd-cc0f-4112-8fa2-101d5e36febc",
      "requiredQty": 5,
      "supplier_ID": "0377357c-978a-4046-a7d2-c6fd39745a1c",
      "estimatedPrice": 100
    }
  ]
}

###---------- GET THE PR ----------
GET {{base}}/PurchaseRequisitions

### ---------- DRAFT -> SUBMITTED ----------
POST  {{base}}/submitPR
Content-Type: application/json

{
    "prID":"6cefaf36-5b22-4a24-b078-a8f5b719d059"
}

