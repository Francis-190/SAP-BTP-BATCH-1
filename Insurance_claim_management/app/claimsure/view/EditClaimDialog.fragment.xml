<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="editClaimDialog" title="Edit Claim" contentWidth="26rem">
        <content>
            <VBox class="sapUiSmallMargin">

                <Label text="Claim Number"/>
                <Input id="ecNumber" editable="false" width="100%"/>

                <Label text="Claimed Amount" required="true"/>
                <Input id="ecAmount" type="Number" width="100%"/>

                <Label text="Incident Date" required="true"/>
                <DatePicker id="ecDate" valueFormat="yyyy-MM-dd" displayFormat="medium" width="100%"/>

                <Label text="Description"/>
                <TextArea id="ecDesc" rows="3" width="100%"/>

            </VBox>
        </content>
        <beginButton>
            <Button text="Save" type="Emphasized" press=".onConfirmEditClaim"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelEditClaim"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>