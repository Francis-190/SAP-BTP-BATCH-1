<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
 
    <Dialog
        id="addProductDialog"
        title="Add Product"
        contentWidth="32rem"
        draggable="true"
        resizable="true">
 
        <content>
            <VBox class="sapUiMediumMargin">
 
                        <Label
            text="Product Code"/>
 
        <Input
            value="{local>/newProduct/productCode}"
            editable="false"
            enabled="false"
            class="sapUiTinyMarginBottom"/>
 
                <Label
                    text="Product Name"
                    required="true"/>
                <Input
                    value="{local>/newProduct/productName}"
                    placeholder="Enter product name"
                    class="sapUiTinyMarginBottom"/>
 
                <Label text="Description"/>
                <TextArea
                    value="{local>/newProduct/description}"
                    rows="3"
                    placeholder="Enter product description"
                    class="sapUiTinyMarginBottom"/>
 
                <Label
                    text="Category"
                    required="true"/>
                <Select
                    width="100%"
                    selectedKey="{local>/newProduct/categoryID}"
                    items="{local>/categories}"
                    class="sapUiTinyMarginBottom">
 
                    <core:Item
                        key="{local>ID}"
                        text="{local>categoryName}"/>
                </Select>
 
                <Label
                    text="Unit Price"
                    required="true"/>
                <Input
                    value="{local>/newProduct/unitPrice}"
                    type="Number"
                    placeholder="Enter unit price"
                    class="sapUiTinyMarginBottom"/>
 
                <Label
                    text="Initial Stock Quantity"
                    required="true"/>
                <Input
                    value="{local>/newProduct/stockQty}"
                    type="Number"
                    placeholder="Enter initial stock"
                    class="sapUiTinyMarginBottom"/>
 
                <Label
                    text="Warehouse"
                    required="true"/>
                <Select
                    width="100%"
                    selectedKey="{local>/newProduct/warehouseID}"
                    items="{local>/warehouses}">
 
                    <core:Item
                        key="{local>ID}"
                        text="{local>warehouseName}"/>
                </Select>
 
            </VBox>
        </content>
 
        <beginButton>
            <Button
                text="Create Product"
                type="Emphasized"
                icon="sap-icon://add"
                press=".onCreateProduct"/>
        </beginButton>
 
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseAddProductDialog"/>
        </endButton>
 
    </Dialog>
 
</core:FragmentDefinition>