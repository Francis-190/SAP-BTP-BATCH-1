{
  "name": "Sales-Inventory",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap-cloud-sdk/resilience": "^4.9.1",
    "@sap/approuter": "^23.0.0",
    "@sap/cds": "^9.9.4",
    "express": "^4",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "cds": {
    "server": {
      "index": true
    },
    "requires": {
      "bpaIntegration": {
        "kind": "rest",
        "credentials": {
          "destination": "bpaIntegration"
        }
      },
      "[production]": {
        "auth": "dummy"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
